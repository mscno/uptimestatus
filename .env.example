# Copy to `.env` (gitignored; mise loads it for development) or pass to `docker run --env-file`.
# See README.md → Configuration for every setting.

# --- Required -----------------------------------------------------------------
UPTIMESTATUS_APP_URL=http://localhost:8080
UPTIMESTATUS_EDGE_HOST=edge.localhost

# --- Database: pick one -------------------------------------------------------
# SQLite (a file; mount a volume at /data in Docker)
UPTIMESTATUS_DATABASE__BACKEND=sqlite
DATABASE_URL=sqlite:/data/uptimestatus.db
# PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/uptimestatus
# Turso Cloud
# UPTIMESTATUS_DATABASE__BACKEND=turso
# DATABASE_URL=libsql://your-db.turso.io
# UPTIMESTATUS_DATABASE__AUTH_TOKEN=

# --- Encryption at rest (required outside debug builds) ------------------------
# docker run --rm ghcr.io/mscno/uptimestatus secrets generate-key   (back the key up!)
UPTIMESTATUS_SECRETS__KEYS=

# --- Email (Lettermint; off unless the project token is set) ------------------
# UPTIMESTATUS_EMAIL__LETTERMINT_PROJECT_TOKEN=lm_...
# UPTIMESTATUS_EMAIL__DEFAULT_FROM=uptimestatus <alerts@example.com>
# UPTIMESTATUS_EMAIL__LETTERMINT_TEAM_TOKEN=lm_team_...   # per-page sending domains
# UPTIMESTATUS_EMAIL__WEBHOOK_SECRET=                     # <APP_URL>/webhooks/lettermint

# --- Sign-in (GitHub OAuth app; callback <APP_URL>/auth/github/callback) -------
UPTIMESTATUS_AUTH__ADMINS=your-github-username
# UPTIMESTATUS_AUTH__GITHUB_CLIENT_ID=
# UPTIMESTATUS_AUTH__GITHUB_CLIENT_SECRET=
# openssl rand -base64 64 | tr -d '\n'   (keeps sessions valid across restarts)
# UPTIMESTATUS_AUTH__COOKIE_KEY=

# --- Optional -----------------------------------------------------------------
UPTIMESTATUS_STORAGE__PATH=/data
# UPTIMESTATUS_CHECKS__HEARTBEAT_URL=
# RUST_LOG=info

# --- Encrypted off-volume backups (SQLite and Turso only) ---------------------
# `fly storage create` injects AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3 and BUCKET_NAME. Keep the age identity off the machine.
# UPTIMESTATUS_BACKUP__ENABLED=true
# UPTIMESTATUS_BACKUP__BUCKET=uptimestatus-backups
# UPTIMESTATUS_BACKUP__RECIPIENT=age1...
# UPTIMESTATUS_BACKUP__AT=03:17
# UPTIMESTATUS_BACKUP__ACCESS_KEY_ID=
# UPTIMESTATUS_BACKUP__SECRET_ACCESS_KEY=
