# Copy to `.env` (gitignored; mise loads it for development) or pass to `docker run --env-file`.
# See README.md → Configuration for every setting.

# --- Required -----------------------------------------------------------------
UPTIMESTATUS_APP_URL=http://localhost:8080
UPTIMESTATUS_EDGE_HOST=edge.localhost

# --- Database: pick one -------------------------------------------------------
# SQLite (a file; mount a volume at /data in Docker)
UPTIMESTATUS_DATABASE__BACKEND=sqlite
DATABASE_URL=sqlite:/data/uptimestatus.db
# PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/uptimestatus
# Turso Cloud
# UPTIMESTATUS_DATABASE__BACKEND=turso
# DATABASE_URL=libsql://your-db.turso.io
# UPTIMESTATUS_DATABASE__AUTH_TOKEN=

# --- Sign-in (GitHub OAuth app; callback <APP_URL>/auth/github/callback) -------
UPTIMESTATUS_AUTH__ADMINS=your-github-username
# UPTIMESTATUS_AUTH__GITHUB_CLIENT_ID=
# UPTIMESTATUS_AUTH__GITHUB_CLIENT_SECRET=
# openssl rand -base64 64 | tr -d '\n'   (keeps sessions valid across restarts)
# UPTIMESTATUS_AUTH__COOKIE_KEY=

# --- Optional -----------------------------------------------------------------
UPTIMESTATUS_STORAGE__PATH=/data
# UPTIMESTATUS_CHECKS__HEARTBEAT_URL=
# RUST_LOG=info
